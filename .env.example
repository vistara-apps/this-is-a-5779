# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration (for Pro subscriptions)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
VITE_STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here

# Note: In production, use environment variables
# For development, copy this file to .env and add your actual API keys
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys
# Create a product and price in Stripe dashboard for the Pro tier
